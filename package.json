{
  "name": "framebound-horde-visual-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test:network": "node scripts/test-network-descendants.mjs && node scripts/test-relay-completion.mjs && node scripts/test-multiplayer-coop.mjs && node scripts/test-peer-recovery.mjs",
    "check": "node scripts/check-syntax.mjs && npm run test:art && npm run test:visual && npm run test:network && npm run test:persistence && npm run test:progression && npm run test:research && npm run test:dev && npm run test:turrets && npm run test:lasers && npm run test:sweep && npm run test:options && npm run test:ui && npm run test:client",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "balance:kps": "node scripts/benchmark-kps.mjs",
    "balance:gameplay": "node scripts/benchmark-gameplay.mjs",
    "balance:curves": "node scripts/balance-curves.mjs",
    "balance:progression": "node scripts/benchmark-progression.mjs",
    "serve": "vite preview --host 127.0.0.1 --port 4173",
    "relay": "npm run build && node scripts/relay-server.mjs",
    "test:art": "node scripts/test-tower-sprites.mjs",
    "test:persistence": "node scripts/test-persistence.mjs",
    "test:progression": "node scripts/test-progression.mjs && node scripts/test-placement-escalator.mjs",
    "test:research": "node scripts/test-research.mjs",
    "test:dev": "node scripts/test-dev-tools.mjs && node scripts/test-part-lab.mjs",
    "test:turrets": "node scripts/test-turret-rework.mjs",
    "test:lasers": "node scripts/test-laser-effects.mjs",
    "test:sweep": "node scripts/test-sweep-collision.mjs",
    "test:options": "node scripts/test-gameplay-options.mjs && node scripts/test-arena-map.mjs",
    "test:ui": "node scripts/test-pixel-ui.mjs && node scripts/test-tactical-actions.mjs",
    "test:visual": "node scripts/test-world-art.mjs",
    "test:client": "node scripts/test-client-modules.mjs",
    "bake:sounds": "node scripts/bake-default-sounds.mjs"
  },
  "dependencies": {
    "jfxr": "^0.13.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "vite": "^7.2.4"
  }
}
